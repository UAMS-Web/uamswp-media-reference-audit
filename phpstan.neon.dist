# Shared starting PHPStan configuration for WordPress code
# (UAMS-Web/uams-claude-skills#10): plugins, must-use plugins, themes. Copy to
# the repository root as `phpstan.neon.dist` and fill in every PLACEHOLDER.
#
# Development dependencies:
#   composer require --dev phpstan/phpstan szepeviktor/phpstan-wordpress php-stubs/wordpress-stubs
# The extension loads the stubs itself; `php-stubs/wordpress-stubs` is required
# explicitly so the WordPress version the stubs describe is pinned in
# composer.json (uamswp-migration-api: `^6.8`). szepeviktor/phpstan-wordpress
# 2.x requires PHPStan 2.x; a repository on PHPStan 1.x upgrades both together.
includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon
    # PHPStan's opt-in preview channel: turns on rules and stricter analysis
    # that become default in the next major, so the eventual major upgrade
    # carries no accumulated analysis debt. Ships inside phpstan/phpstan, so it
    # adds no dependency.
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon
    # Optional, when the repository uses Mockery:
    # - vendor/phpstan/phpstan-mockery/extension.neon
    # When the tests run on Pest: Pest's own extension, shipped inside
    # pestphp/pest. It registers Pest's expectation classes as universal object
    # crates, so chained expectations analyze instead of reporting undefined
    # properties. Uncomment together with the Pest entries under ignoreErrors.
    - vendor/pestphp/pest/extension.neon

parameters:
    # the PHP versions the code must parse and run on. `min` is the
    # LOWEST version the plugin supports (composer.json's `php` constraint and
    # the plugin header's `Requires PHP`); `max` is the developer's PHP, which
    # the tools run on. Left out, PHPStan infers a version from composer.json
    # and does not report constructs that are unavailable at the floor: in
    # uamswp-migration-api a typed class constant (PHP 8.3+) analyzed clean and
    # would have been a parse error on the PHP 8.2 it ships to. Integers:
    # 7.0 = 70000, 7.4 = 70400, 8.2 = 80200, 8.4 = 80400. The range form needs
    # PHPStan 2.0 or later.
    phpVersion:
        min: 80200
        max: 80400

    # the highest level the code passes today. Find it by running
    # from 0 upward (see the code-quality skill), then raise it by one per
    # change as findings are fixed, until `max`. Lowering it is a deliberate,
    # argued change, not a quiet edit to get a red run green.
    level: 5

    # the directories and files holding first-party PHP, including
    # the plugin header file at the root. Include tests: test bugs are real
    # bugs. In a fork of a vendor plugin, only the paths that hold our
    # modifications.
    paths:
        - includes
        - scripts
        - tests
        - uamswp-media-reference-audit.php
        - uninstall.php

    # The Integration suite's own Composer setup: its vendor/ sits inside `tests`,
    # so it is excluded from analysis, under `analyse` only, so its WordPress
    # test classes can still be scanned below.
    excludePaths:
        analyse:
            - tests/Integration/vendor

    # WP-CLI's classes and functions. includes/class-cli.php registers the
    # `uams-media-audit` command, and php-stubs/wordpress-stubs stops at core,
    # so without this every WP_CLI call reports class.notFound at level 0.
    scanFiles:
        - vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php
        # cli\progress\Bar, which WP_CLI\Utils\make_progress_bar() returns.
        - vendor/php-stubs/wp-cli-stubs/wp-cli-tools-stubs.php

    # UAMS_MRA_URL is defined from plugin_dir_url() in the plugin header, which
    # PHPStan cannot evaluate; the bootstrap defines it for analysis and
    # dynamicConstantNames stops PHPStan narrowing it to the placeholder value.
    bootstrapFiles:
        - tests/phpstan/bootstrap.php
    dynamicConstantNames:
        - UAMS_MRA_URL

    # Indexed for symbols but not analyzed. `php-stubs/wordpress-stubs` covers
    # core's runtime surface and stops there: `WP_UnitTestCase`, the factories
    # and `tests_add_filter()` ship with WordPress' test suite, not with
    # WordPress. The Integration suite runs on wp-phpunit, and without these paths
    # it analyzes as a pile of undefined classes. They sit in the Integration
    # suite's own Composer setup, so `composer setup:integration` must have run.
    scanDirectories:
        - tests/Integration/vendor/wp-phpunit/wp-phpunit/includes
        - tests/Integration/vendor/yoast/phpunit-polyfills/src

    # Checkout-scoped cache. PHPStan's default tmpDir is
    # `sys_get_temp_dir()/phpstan`: machine-global, shared by every checkout and
    # worktree on the machine. The cache stores ABSOLUTE phar paths, so deleting
    # the worktree that populated it leaves every stored path dangling, and the
    # next run in a live checkout dies with internal errors of the form
    # `"phar://.../vendor/phpstan/phpstan.phar/..." is not a file`, blaming
    # whichever source file happened to be under analysis. That reads as a real
    # defect in the diff.
    #
    # Neither obvious remedy works: `clear-result-cache` leaves most of the
    # directory in place, and `rm -rf` races any concurrent session analyzing
    # in it. A RELATIVE path resolves against this file's directory, so each
    # checkout gets its own cache and a deleted one takes only its own with it.
    # There is no `--tmp-dir` CLI flag, so this key is the only lever.
    # Add `/.phpstan/` to .gitignore.
    tmpDir: .phpstan

    # WordPress ships a very large global function surface; the stubs cover it,
    # but core's own docblocks are loose enough that a few dynamic returns
    # cannot be narrowed. Add ignores here only with a comment naming the core
    # function responsible, pinned by `identifier` and `path`. Never a blanket
    # pattern. Unmatched entries fail the run (`reportUnmatchedIgnoredErrors`
    # defaults to true), so a stale ignore reds rather than rots.
    #
    # The template ships with no active entry, so a first run at `level: 0` on
    # clean code passes. An entry whose error does not occur fails the run as
    # `ignore.unmatched` unless it says `reportUnmatched: false`, so uncomment
    # each entry below only when its error appears (the Pest entries: when the
    # tests run on Pest). The entries already sit in the list, at the list's
    # indentation, so removing the leading `# ` from an entry's lines is all
    # an entry needs. With every entry commented out the key is empty, which
    # PHPStan reads as no entries.
    ignoreErrors:
        # get_sites() with 'fields' => 'ids' returns int[]. The stubs say so
        # through a conditional return on `array{fields: 'ids'}`, but under
        # bleedingEdge an array shape is sealed, so arguments carrying other
        # keys as well ('number', 'site__not_in') miss the condition and
        # PHPStan falls back to WP_Site[]. Both calls pass 'fields' => 'ids'.
        -
            identifier: argument.type
            message: '#^Parameter \#1 \$callback of function array_map expects \(callable\(WP_Site\)#'
            path: includes/class-scanner.php
        -
            identifier: argument.type
            message: '#^Parameter \#1 \$new_blog_id of function switch_to_blog expects int, WP_Site given\.$#'
            path: uninstall.php

        # wp_get_attachment_metadata(): the stubs' array shape omits
        # 'original_image', which core has written since WordPress 5.3 for a
        # big image it scaled down, so both reads of it report a missing
        # offset. The same shape types 'sizes' as an array, which makes the
        # is_array() beside it look redundant; the value is read back from
        # post meta, where nothing guarantees the shape, so the check stays.
        -
            identifier: empty.offset
            path: includes/class-scanner.php
        -
            identifier: offsetAccess.notFound
            path: includes/class-scanner.php
        -
            identifier: booleanAnd.rightAlwaysTrue
            path: includes/class-scanner.php

        # ZipArchive::setCompressionName() exists on every PHP from 7.0, so
        # PHPStan is right that the method_exists() guard in front of it is
        # always true at the 8.2 floor. Removing a runtime guard is a behavior
        # decision outside this adoption, which changes no behavior; remove
        # this entry in the same change that removes the guard.
        -
            identifier: function.alreadyNarrowedType
            path: includes/class-archive.php

        # `$this` inside a closure passed to `uses()->beforeEach()` / `afterEach()`
        # is bound by Pest at runtime, which PHPStan cannot see. Pinned to
        # `tests/Pest.php`, so the same error anywhere else still fails.
        -
            identifier: variable.undefined
            message: '#^Undefined variable: \$this$#'
            path: tests/Pest.php
            reportUnmatched: false
        # Pest routes its public API through classes it tags @internal; calling
        # them from a test is Pest's intended use.
        -
            identifier: method.internalClass
            message: '#of internal class Pest\\#'
            path: tests
            reportUnmatched: false
        # The entry most plugins need once the level reaches 4, from
        # uamswp-migration-api: the PHP version guard in the plugin header.
        # PHPStan analyzes at the `min` above, so
        # `version_compare(PHP_VERSION, '8.2', '<')` is always false *to the
        # analyzer*, but the guard exists precisely for the case the analyzer
        # cannot model: a site downgraded underneath an already-active plugin,
        # where the alternative to this branch is a fatal error instead of an
        # admin notice. PHPStan reports `if.alwaysFalse` from level 4, and only
        # where the header has such a guard; below that, or without the guard,
        # this entry is unmatched and fails the run. (The range form of
        # `phpVersion` keeps it matching; the single-integer form does not.)
        # -
        #     identifier: if.alwaysFalse
        #     path: my-plugin.php

        # When the tests run on Pest (with the extension above), three entries,
        # each pinned to `tests/`, so the same error anywhere else still fails.
        # They carry `reportUnmatched: false` because whether they match
        # depends on the level and on which calls a suite happens to make: the
        # internal-class entry matches only from level 2, and a suite whose
        # `Pest.php` never uses `$this` has nothing for the first entry to
        # match. Measured on the `tests` skill's WordPress plugin template with
        # PHPStan 2.2 and Pest 3.8, 2026-10-02: without them it fails at
        # level 0 on the first two.
        #
        # `$this` inside a closure passed to `uses()->beforeEach()` /
        # `afterEach()` is bound by Pest at runtime, which PHPStan cannot see.
        # -
        #     identifier: variable.undefined
        #     message: '#^Undefined variable: \$this$#'
        #     path: tests/Pest.php
        #     reportUnmatched: false
        # `$this` inside an `it()` closure analyzes as PHPUnit's TestCase
        # whatever `uses(...)->in('Integration')` binds, so a WP_UnitTestCase
        # method such as `go_to()` reads as undefined. Scoped to that suite.
        # -
        #     identifier: method.notFound
        #     message: '#^Call to an undefined method PHPUnit\\Framework\\TestCase::#'
        #     path: tests/Integration
        #     reportUnmatched: false
        # Pest routes its public API through classes it tags @internal;
        # calling them from a test is Pest's intended use.
        # -
        #     identifier: method.internalClass
        #     message: '#of internal class Pest\\#'
        #     path: tests
        #     reportUnmatched: false
